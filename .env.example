# Copy this file to .env. Do not commit .env.
# On Render, set these in the service environment. A missing .env file is fine
# when the variables are already present in the process environment.

# Required. Use the same value in subscriptions-ws.
SECRET_KEY=replace-with-a-long-random-string

# Required. Use the same database from subscriptions-ws.
MONGOOSE_URI=mongodb+srv://USER:PASSWORD@cluster.example.net/DATABASE

# Required. One frontend origin, including the scheme. No comma-separated list.
# Local: http://localhost:5173
ORIGIN=http://localhost:5173

# Render sets this. Local default is 3000. Do not hardcode Render's port.
PORT=

# Set to 1 on Render so the one proxy hop is trusted for rate limiting.
# Leave empty for local development.
TRUST_PROXY_HOPS=

# Required only for the admin welcome email. Account creation still succeeds
# when mail cannot be sent.
SMTP_HOST=smtp.example.net
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASS=replace-with-smtp-password
SMTP_SECURE=false
MAIL_FROM=CinemaHub <mailer@example.com>

# Optional. Set to 1 to log SMTP conversation details.
SMTP_DEBUG=

# Render web service "cinemahub-users-api"
# Build command: npm install
# Start command: npm start
# Node.js 20 or newer
# SECRET_KEY must match cinemahub-catalog-api.
# MONGOOSE_URI must use the same database as cinemahub-catalog-api.
# ORIGIN must be the public frontend origin.
# TRUST_PROXY_HOPS=1
# The running API stores users in MongoDB. It does not read operational JSON.
